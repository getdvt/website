---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Handraise from '../../components/Handraise.astro';
import Footer from '../../components/Footer.astro';
import EChart from '../../components/EChart.astro';
import SpecReveal from '../../components/SpecReveal.astro';
import { resolveChartDef, groupOf, siblingsFor } from '../../data/chart-page-lookup';

export const prerender = true;

// dvt's bundled `world` map compiles chart:geo:animated as a timeline
// choropleth (a `map` series + visualMap driven by a time field), not the
// effectScatter ripple animation this page renders — call that out so a
// reader doesn't mistake the stand-in for the real playback.
const PAGE_NOTES: Record<string, string> = {
  'geo-animated':
    'Illustrative animation — in a dvt build, chart:geo:animated plays a timeline choropleth over your bound regions; the ripples here stand in for that playback.',
};

export async function getStaticPaths() {
  const pages = await getCollection('chartPages');
  return pages.map((p) => ({
    params: { slug: p.id },
    props: { page: p },
  }));
}

const { page } = Astro.props;

const def = resolveChartDef(page.data.type);
// Drift tripwire: every chart-pages.json entry must resolve to a real,
// renderable ChartDef (charts.ts `families` ∪ chart-page-extras.ts). A
// missing/renamed entry on either side must fail the build, not ship a
// blank chart.
if (!def || !def.option) {
  throw new Error(
    `charts/[slug]: chart-pages.json entry '${page.id}' (type '${page.data.type}') did not ` +
      `resolve to a ChartDef with an 'option' — check src/data/charts.ts \`families\` and ` +
      `src/data/chart-page-extras.ts \`chartPageExtras\`.`
  );
}

// Margin-affordance transform (founder requirement): a named yAxis needs
// enough top grid room + label gap that its title never collides with the
// plot; every grid should containLabel so axis labels don't clip. Never
// mutates the shared, imported ChartDef option.
function ensureHeadroom(option: Record<string, unknown>): Record<string, unknown> {
  const opt = structuredClone(option) as Record<string, any>;

  // `grid` may be a single object or an array of grids (multi-grid charts);
  // normalize so every rule below applies uniformly to each entry.
  const getGrids = (): any[] | null => {
    if (Array.isArray(opt.grid)) return opt.grid;
    if (opt.grid && typeof opt.grid === 'object') return [opt.grid];
    return null;
  };
  const ensureGrids = (): any[] => {
    const existing = getGrids();
    if (existing) return existing;
    opt.grid = {};
    return [opt.grid];
  };
  const bumpGridMin = (key: 'top' | 'bottom', min: number) => {
    for (const g of ensureGrids()) {
      if (typeof g[key] !== 'number' || g[key] < min) g[key] = min;
    }
  };

  const yAxis = Array.isArray(opt.yAxis) ? opt.yAxis[0] : opt.yAxis;
  if (yAxis && typeof yAxis === 'object' && yAxis.name) {
    bumpGridMin('top', 64);
    if (typeof yAxis.nameGap !== 'number' || yAxis.nameGap < 20) yAxis.nameGap = 20;
    // The name is drawn center-anchored on the axis line by default, which
    // overflows past the left canvas edge for long names. Left-align it so
    // it starts at the axis line and grows rightward instead.
    if (!yAxis.nameTextStyle?.align) {
      yAxis.nameTextStyle = { ...(yAxis.nameTextStyle ?? {}), align: 'left' };
    }
  }

  const xAxis = Array.isArray(opt.xAxis) ? opt.xAxis[0] : opt.xAxis;
  if (xAxis && typeof xAxis === 'object' && xAxis.name) {
    bumpGridMin('bottom', 48);
    if (typeof xAxis.nameGap !== 'number' || xAxis.nameGap < 26) xAxis.nameGap = 26;
  }

  // Horizontal visualMap sliders (heatmap, etc.) sit at the bottom of the
  // chart and clip x-axis labels unless the grid leaves room for them.
  // Skip non-cartesian charts (e.g. the choropleth map) — they have a
  // visualMap but no grid/axes and must pass through unchanged.
  const visualMap = Array.isArray(opt.visualMap) ? opt.visualMap[0] : opt.visualMap;
  const isCartesian = Boolean(opt.xAxis || opt.yAxis);
  if (
    visualMap &&
    typeof visualMap === 'object' &&
    isCartesian &&
    (visualMap.orient === 'horizontal' || (visualMap.orient === undefined && 'bottom' in visualMap))
  ) {
    if (typeof visualMap.bottom !== 'number') visualMap.bottom = 0;
    bumpGridMin('bottom', 72);
  }

  const grids = getGrids();
  if (grids) for (const g of grids) g.containLabel = true;

  return opt;
}

const option = ensureHeadroom(def.option);
// Deliberate build-time parse: an invalid `spec` snippet must fail the
// build rather than ship broken JSON to a reader who copies it.
const prettySpec = JSON.stringify(JSON.parse(def.spec), null, 2);

const group = groupOf(page.data.type);
const siblings = siblingsFor(page.data.type);
const pageNote = PAGE_NOTES[page.id];

const pageURL = new URL(`/charts/${page.id}/`, Astro.site).href;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dvt.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Charts', item: 'https://dvt.dev/charts/' },
      { '@type': 'ListItem', position: 3, name: page.data.title, item: pageURL },
    ],
  },
];
---

<Base
  title={`${page.data.title} — example + JSON spec | dvt`}
  description={page.data.metaDescription}
  jsonLd={jsonLd}
>
  <Nav />
  <main>
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href="/charts/">Charts</a>
          <span class="sep" aria-hidden="true">/</span>
          <span aria-current="page">{page.data.title}</span>
        </nav>
        {group && <div class="eyebrow">{group.label}</div>}
        <h1>{page.data.title}</h1>
        <p class="lead">{page.data.whenToUse}</p>
      </div>
    </section>

    <section class="section chart-section">
      <div class="container">
        <div class="chart-card">
          <EChart option={option} height="320px" animate={def.animate} label={page.data.title} />
          {pageNote && <p class="chart-note">{pageNote}</p>}
        </div>
      </div>
    </section>

    <section class="section spec-section">
      <div class="container narrow">
        <h2>Minimal dvt spec</h2>
        <p>
          The panel body for a {page.data.title.toLowerCase()}. Add an <code>id</code> and <code>title</code>,
          give it a <code>data</code> block whose <code>query</code> points at
          your warehouse, and it drops into any dvt dashboard.
        </p>
        <SpecReveal code={prettySpec} lang="json" open={true} />
      </div>
    </section>

    <section class="section outro-section">
      <div class="container narrow">
        <h2>Build it in dvt</h2>
        <p>
          Every chart type on this site is a few lines of the same declarative JSON spec. Read
          the full <a href="/spec">spec format</a>, or connect an AI agent to your warehouse and
          build one live in the <a href="/quickstart">quickstart</a>.
        </p>
      </div>
    </section>

    {siblings.length > 0 && (
      <section class="section related-section">
        <div class="container">
          <h2>Related chart types</h2>
          <div class="related-grid">
            {siblings.map((s) => (
              <a href={`/charts/${s.id}/`} class="related-link">{s.title}</a>
            ))}
          </div>
        </div>
      </section>
    )}

    <Handraise />
  </main>
  <Footer />
</Base>

<script>
  import '../../scripts/charts.ts';
</script>

<style>
  .page-hero {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: 1px solid var(--color-neutral-200);
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
    margin-bottom: var(--space-5);
  }
  .breadcrumb a {
    color: var(--color-neutral-500);
    transition: color var(--transition-fast);
  }
  .breadcrumb a:hover {
    color: var(--color-neutral-900);
  }
  .breadcrumb .sep {
    color: var(--color-neutral-300);
  }
  .breadcrumb [aria-current='page'] {
    color: var(--color-neutral-600);
  }
  .eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-mark);
    margin-bottom: var(--space-4);
  }
  .page-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-neutral-900);
    margin-bottom: var(--space-5);
    max-width: 700px;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-neutral-600);
    line-height: 1.7;
    max-width: 700px;
  }

  .section {
    padding: var(--space-12) 0;
  }
  .chart-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }
  .container.narrow {
    max-width: 720px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  /* Chart card: generous padding so legends/axis labels never clip. */
  .chart-card {
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6) var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .chart-note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    text-align: center;
  }

  .spec-section h2,
  .outro-section h2,
  .related-section h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-neutral-900);
    margin-bottom: var(--space-3);
  }
  .spec-section p,
  .outro-section p {
    font-size: var(--text-base);
    color: var(--color-neutral-600);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }
  .spec-section p code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
  }
  .outro-section a {
    color: var(--color-brand-indigo);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .outro-section a:hover {
    color: var(--color-brand-indigo-dark);
  }

  .related-section {
    border-top: 1px solid var(--color-neutral-200);
    background: var(--bg-secondary);
  }
  .related-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .related-link {
    display: inline-flex;
    align-items: center;
    padding: 10px var(--space-5);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-neutral-700);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .related-link:hover {
    border-color: var(--color-brand-mark);
    color: var(--color-neutral-900);
  }
</style>
