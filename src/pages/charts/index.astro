---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Handraise from '../../components/Handraise.astro';
import Footer from '../../components/Footer.astro';
import { pageGroups } from '../../data/chart-page-lookup';
import { families } from '../../data/charts';

export const prerender = true;

const groups = pageGroups();

const groupBlurb: Record<string, string> = Object.fromEntries(
  families.map((f) => [f.id, f.blurb])
);
groupBlurb.maps = 'Geography-encoded measures: choropleths and time-lapse spread.';

// Static, per-group glyphs — 34 live ECharts canvases on one index page would
// be heavy for zero payoff; a small neutral-tone SVG per family is enough to
// scan the page.
const GLYPHS: Record<string, string> = {
  comparison:
    '<rect x="5" y="16" width="5" height="11" rx="1"/><rect x="14" y="9" width="5" height="18" rx="1"/><rect x="23" y="13" width="5" height="14" rx="1"/>',
  trend:
    '<polyline points="4,23 11,15 17,19 28,6" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>',
  'part-to-whole':
    '<circle cx="16" cy="16" r="10" fill="none" stroke-width="5"/><path d="M16 6 A10 10 0 0 1 24 22" fill="none" stroke-width="5" opacity="0.4"/>',
  correlation:
    '<circle cx="8" cy="21" r="2"/><circle cx="15" cy="14" r="2"/><circle cx="21" cy="18" r="2"/><circle cx="26" cy="9" r="2"/><circle cx="12" cy="24" r="2"/>',
  flow:
    '<path d="M4 8 C14 8 14 16 24 16 C14 16 14 24 4 24" fill="none" stroke-width="2"/><path d="M4 16 L28 16" fill="none" stroke-width="2" opacity="0.35"/>',
  statistical:
    '<rect x="10" y="11" width="12" height="10" rx="1" fill="none" stroke-width="2"/><line x1="16" y1="5" x2="16" y2="11" stroke-width="2"/><line x1="16" y1="21" x2="16" y2="27" stroke-width="2"/>',
  animated: '<path d="M10 6 L26 16 L10 26 Z"/>',
  maps:
    '<circle cx="16" cy="16" r="11" fill="none" stroke-width="2"/><path d="M5 16 H27 M16 5 C21 10 21 22 16 27 C11 22 11 10 16 5 Z" fill="none" stroke-width="1.4" opacity="0.55"/>',
};
// Fallback for a future family the static maps above don't cover yet — a
// neutral dot glyph and an empty blurb, so an unknown group renders sanely
// instead of a blank/broken card head.
const FALLBACK_GLYPH = '<circle cx="16" cy="16" r="6"/>';

const allPages = groups.flatMap((g) => g.pages);
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dvt.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Charts', item: 'https://dvt.dev/charts/' },
    ],
  },
  {
    '@type': 'ItemList',
    itemListElement: allPages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.title,
      url: `https://dvt.dev/charts/${p.id}/`,
    })),
  },
];
---

<Base
  title="Chart types — examples + JSON specs | dvt"
  description="34 chart types: when to use each, a live ECharts example, and a minimal JSON spec you can drop straight into a dvt dashboard."
  jsonLd={jsonLd}
>
  <Nav />
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">Chart types</div>
        <h1>{allPages.length} chart types, each a few lines of spec.</h1>
        <p class="lead">
          Open a type for a live ECharts render, the same library dvt dashboards draw with,
          guidance on when to use it, and a minimal JSON spec you can copy straight into a
          dashboard.
        </p>
      </div>
    </section>

    <div class="charts-layout">
      <nav class="section-nav" aria-label="Chart families">
        {groups.map(({ group }) => (
          <a href={`#${group.id}`}>{group.label}</a>
        ))}
      </nav>

      <div class="sections-column">
        {groups.map(({ group, pages }) => (
          <section class="section group-section" id={group.id}>
            <div class="container">
              <div class="group-head">
                <svg class="group-glyph" viewBox="0 0 32 32" aria-hidden="true" set:html={GLYPHS[group.id] ?? FALLBACK_GLYPH} />
                <div>
                  <h2>{group.label}</h2>
                  <p>{groupBlurb[group.id] ?? ''}</p>
                </div>
              </div>
              <div class="card-grid">
                {pages.map((p) => (
                  <a href={`/charts/${p.id}/`} class="type-card">
                    <h3>{p.title}</h3>
                    <p>{p.summary}</p>
                  </a>
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>
    </div>

    <Handraise />
  </main>
  <Footer />
</Base>

<style>
  .page-hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-neutral-200);
  }
  .eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-mark);
    margin-bottom: var(--space-4);
  }
  .page-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-neutral-900);
    margin-bottom: var(--space-5);
    max-width: 720px;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-neutral-600);
    line-height: 1.65;
    max-width: 620px;
  }

  /* ── Left-side section nav (desktop only, see breakpoint below) ──── */
  /* Below 1024px .charts-layout stays a plain block wrapper (no width/padding
     of its own) so the section markup renders pixel-identical to before this
     nav existed: each .group-section keeps spanning full viewport width with
     its own .container centering the content. */
  .section-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .charts-layout {
      display: flex;
      align-items: flex-start;
      gap: var(--space-8);
      /* 1080px .container max-width + 200px nav column + var(--space-8) (32px)
         gap + 2 * var(--space-6) of this element's own padding-inline
         (box-sizing: border-box, see global.css:13-16, so that padding comes
         out of max-width rather than adding on top of it), so
         .sections-column resolves to exactly 1080px: the same cap every
         other page on the site uses, instead of a bespoke width. */
      max-width: 1360px;
      margin-inline: auto;
      padding-inline: var(--space-6);
    }
    .section-nav {
      display: flex;
      flex-direction: column;
      flex: 0 0 200px;
      gap: var(--space-2);
      position: sticky;
      /* Site nav (Nav.astro) is sticky at top:0, height 60px; clear it plus a
         little breathing room. */
      top: calc(60px + var(--space-6));
      padding: var(--space-4) 0;
    }
    .section-nav a {
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-neutral-500);
      transition: color var(--transition-fast), background var(--transition-fast);
    }
    .section-nav a:hover {
      color: var(--color-neutral-900);
    }
    .section-nav a:focus-visible {
      outline: 2px solid var(--color-brand-mark);
      outline-offset: 2px;
    }
    .section-nav a[aria-current='true'] {
      color: var(--color-neutral-900);
      background: var(--color-neutral-100);
      font-weight: 600;
    }
    .sections-column {
      flex: 1;
      min-width: 0;
    }
  }

  /* Astro scopes this component's styles to elements it renders; <html> is
     rendered by Base.astro, so this needs :global to actually reach it. */
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .group-section {
    padding: var(--space-16) 0;
    /* Land an anchor jump clear of the fixed site nav. Deliberately NOT inside the
       1024px block: a deep link like /charts#trend has to clear the nav on mobile
       too, where the nav's height is `auto` rather than the desktop 60px, so the
       base uses a viewport-independent allowance. Both rules live here, in this
       order, because they have equal specificity — the desktop override only wins
       by coming second in source. */
    scroll-margin-top: var(--space-16);
  }
  @media (min-width: 1024px) {
    .group-section {
      scroll-margin-top: calc(60px + var(--space-6));
    }
  }
  .group-section:not(:last-of-type) {
    border-bottom: 1px solid var(--color-neutral-200);
  }
  .group-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .group-glyph {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    color: var(--color-brand-mark);
    stroke: currentColor;
    fill: currentColor;
    margin-top: 2px;
  }
  .group-head h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-neutral-900);
    margin-bottom: var(--space-1);
  }
  .group-head p {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    max-width: 60ch;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
  }
  .type-card {
    display: block;
    padding: var(--space-5);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .type-card:hover {
    border-color: var(--color-brand-mark);
    box-shadow: var(--shadow-md);
  }
  .type-card h3 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-neutral-900);
    margin-bottom: var(--space-2);
  }
  .type-card p {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    line-height: 1.55;
  }
</style>

<script>
  // Highlights the section-nav link for whichever chart-family section is
  // currently in view. Guards on the nav element so it no-ops if absent.
  // Below 1024px the nav is display:none but still present in markup, so
  // this still runs there too, harmlessly, since the nav is invisible.
  const nav = document.querySelector<HTMLElement>('.section-nav');

  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const sections = links
      .map((link) => document.getElementById(link.getAttribute('href')!.slice(1)))
      .filter((section): section is HTMLElement => section !== null);

    const setActive = (id: string) => {
      for (const link of links) {
        if (link.getAttribute('href') === `#${id}`) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    if (sections.length > 0) {
      // An IO callback receives only the targets whose intersection CHANGED, not
      // the full observed set — so scrolling out of a section can fire with a
      // single non-intersecting entry, which would leave the highlight stuck on
      // the section just left. Keep a running map of every section's visibility
      // and pick the winner across the whole map each time.
      //
      // Compare intersected HEIGHT, not intersectionRatio: ratio is normalised by
      // each section's own height, so under this shrunk root band it systematically
      // favours short sections (Maps, 4 cards) over tall ones (Comparison).
      const visibleHeight = new Map();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            visibleHeight.set(
              entry.target.id,
              entry.isIntersecting ? entry.intersectionRect.height : 0
            );
          }
          let bestId = null;
          let bestHeight = 0;
          for (const [id, height] of visibleHeight) {
            if (height > bestHeight) {
              bestHeight = height;
              bestId = id;
            }
          }
          if (bestId !== null) {
            setActive(bestId);
          }
        },
        // Treat the band just below the fixed site nav down to the vertical
        // midpoint of the viewport as "in view" for active-state purposes.
        { rootMargin: '-96px 0px -50% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
      );

      sections.forEach((section) => observer.observe(section));
    }
  }
</script>
