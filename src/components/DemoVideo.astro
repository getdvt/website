---
/**
 * Shared demo-video section: the finished product film, embedded on the
 * homepage and /product. Click-to-play only — no autoplay, no reveal.
 */
interface Props {
  heading?: string;
  sub?: string;
  slug?: string;
  figcaption?: string;
  ariaLabel?: string;
}

const {
  heading = 'Watch dvt build a dashboard, then verify it.',
  sub = 'One Claude Code session turns a live Postgres connection into a working dashboard, then traces a number on it back to the exact SQL, and through it to the table and column that produced it.',
  slug = 'dvt-demo',
  figcaption = '2:13 · silent screen capture',
  ariaLabel = 'dvt product demo: a Claude Code session builds a dashboard on a live Postgres connection, then traces a number back to its source SQL, table, and column. Silent screen capture, 2 minutes 13 seconds.',
} = Astro.props;
---

<section class="demo-video">
  <div class="container">
    <h2>{heading}</h2>
    <p class="dv-sub">
      {sub}
    </p>
    <figure>
      <video
        controls
        preload="none"
        playsinline
        poster={`/demo/${slug}-poster.jpg`}
        width="1440"
        height="900"
        aria-label={ariaLabel}
      >
        <source src={`/demo/${slug}.webm`} type="video/webm" />
        <source src={`/demo/${slug}.mp4`} type="video/mp4" />
        Your browser doesn't support embedded video. <a href={`/demo/${slug}.mp4`}>Download the film</a> instead.
      </video>
      <figcaption>{figcaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .demo-video {
    padding: var(--space-section) 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--color-neutral-200);
  }
  .demo-video h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-neutral-900);
    margin-bottom: var(--space-3);
  }
  .dv-sub {
    font-size: var(--text-base);
    color: var(--color-neutral-600);
    line-height: 1.65;
    max-width: 60ch;
    margin-bottom: var(--space-8);
  }
  figure {
    margin: 0;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 900;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: var(--color-neutral-100);
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
    margin-top: var(--space-2);
  }
</style>
